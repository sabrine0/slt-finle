PORT=4010
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=stls
DB_PASSWORD=stls_dev_password
DB_NAME=stls_hybrid
DB_SSL=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
ACCESS_TOKEN_SECRET=replace-with-strong-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
REFRESH_TOKEN_TTL=7d
DEPLOYMENT_SIGNING_SECRET=replace-with-strong-deployment-signing-secret
CONTROLLER_ACCESS_TOKEN_SECRET=replace-with-strong-controller-access-secret
CONTROLLER_ACCESS_TOKEN_TTL=12h
CONTROLLER_HEARTBEAT_TIMEOUT_SECONDS=90
BCRYPT_SALT_ROUNDS=12
SEED_DEFAULT_USERS=true
SEED_DEFAULT_PASSWORD=ChangeMe123!
JWT_ISSUER=stls-hybrid

# --- Engineering reference layer (read-only document index) ------------
# Absolute path to the folder that holds the real engineering reference
# files (Plan RS / Dossier Régulation / Plan Filaire / Programme ZIPs).
# Required for local/dev use of the engineering-references module —
# without it the document-ingest scan refuses to run and the linked-
# document panels stay empty.
#
# Typical local value on the engineering workstation:
#   STLS_ENGINEERING_REFERENCES_ROOT=D:\sabrine
#
# The ingest service expects the following subfolder layout under the
# root (any missing subfolder is skipped, never an error):
#   <root>/OneDrive_2026-04-14/PLans RS Fès    → plan_rs (city=Fès)
#   <root>/Dossier de Régulation               → dossier_regulation
#   <root>/Plan Filaire                        → plan_filaire
#   <root>/Programme                           → programme_archive (ZIP)
#   <root>/Dossiers_Régulation_Marrakech       → dossier_regulation (city=Marrakech)
#
# Optional: install `unzipper` to enable the inner-file inventory of
# programme ZIPs (.clp9 / .wpr / .pdf), otherwise the inventory stays
# empty and the package itself is still indexed.
#   cd backend && npm install unzipper @types/unzipper
STLS_ENGINEERING_REFERENCES_ROOT=
