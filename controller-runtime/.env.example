# ─────────────────────────────────────────────────────────────────────────────
# STLS Controller Runtime — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments.

# ── Backend connectivity ──────────────────────────────────────────────────────

# Full URL of the STLS backend (no trailing slash).
STLS_BACKEND_URL=http://localhost:4010

# Controller credentials issued by an engineer via the Engineering Studio.
# Required — the runtime will not start without these.
STLS_CLIENT_ID=ctrl_xxxxxxxxxxxxxxxxxxxxxxxx
STLS_CLIENT_SECRET=change-me-secret

# Optional: if set, the backend will verify that the credential belongs to the
# controller with this code (extra security check against credential misuse).
# STLS_CONTROLLER_CODE=CTL-001

# ── Shared signing secret ─────────────────────────────────────────────────────

# Must match DEPLOYMENT_SIGNING_SECRET in the backend .env.
# Used to verify the HMAC-SHA256 signature on deployment packages.
STLS_DEPLOYMENT_SIGNING_SECRET=local-dev-deployment-signing-secret

# ── Controller identity ───────────────────────────────────────────────────────

STLS_RUNTIME_VERSION=1.0.0
STLS_FIRMWARE_VERSION=1.0.0

# "real" or "simulation"
STLS_OPERATING_ENVIRONMENT=simulation

# ── Timing intervals ──────────────────────────────────────────────────────────

# How often to send a heartbeat to the backend.
STLS_HEARTBEAT_INTERVAL=30s

# How often to upload detailed telemetry.
STLS_TELEMETRY_INTERVAL=60s

# How often to poll the backend for a new deployment package.
STLS_PACKAGE_POLL_INTERVAL=10s

# How long to wait between bootstrap retries on failure.
STLS_BOOTSTRAP_RETRY_DELAY=10s

# ── Persistence ───────────────────────────────────────────────────────────────

# Where to cache the JWT access token (survives process restarts).
STLS_TOKEN_CACHE_PATH=cache/token.json

# Where to cache the last deployment package (enables offline operation).
STLS_PACKAGE_CACHE_PATH=cache/package.json

# ── Logging ───────────────────────────────────────────────────────────────────

# One of: debug, info, warn, error
STLS_LOG_LEVEL=info
